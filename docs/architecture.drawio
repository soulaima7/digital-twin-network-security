<mxfile host="app.diagrams.net"><diagram name="Architecture Phase 1" id="p1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1360" pageHeight="840"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Digital Twin for Network Security — Architecture Phase 1" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Zone ATK — « Internet » — 10.10.30.0/24" style="rounded=1;dashed=1;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="300" height="170" as="geometry"/></mxCell><mxCell id="c5" value="Zone LAN — VLAN 10 — 10.10.10.0/24" style="rounded=1;dashed=1;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="200" y="520" width="320" height="170" as="geometry"/></mxCell><mxCell id="c6" value="Zone DMZ — VLAN 20 — 10.10.20.0/24" style="rounded=1;dashed=1;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="600" y="520" width="320" height="170" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;fw&lt;/b&gt;&lt;br&gt;Pare-feu nftables + routeur inter-VLAN&lt;br&gt;eth1.10 : 10.10.10.1 | eth1.20 : 10.10.20.1&lt;br&gt;eth2 : 10.10.30.1 | mgmt 172.20.20.2" style="rounded=1;html=1;whiteSpace=wrap;strokeWidth=2;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="450" y="150" width="300" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;sw&lt;/b&gt; — Switch L2 (bridge Linux, 802.1Q)&lt;br&gt;eth1 trunk | eth2 VLAN 10 | eth3 VLAN 20&lt;br&gt;mgmt 172.20.20.6" style="rounded=1;html=1;whiteSpace=wrap;strokeWidth=2;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="460" y="360" width="280" height="80" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;attacker&lt;/b&gt;&lt;br&gt;nmap, hydra, ab&lt;br&gt;eth1 : 10.10.30.10&lt;br&gt;mgmt 172.20.20.5" style="rounded=1;html=1;whiteSpace=wrap;strokeWidth=2;fontSize=12;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="90" y="190" width="200" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;client&lt;/b&gt;&lt;br&gt;Poste utilisateur (curl)&lt;br&gt;eth1 : 10.10.10.10&lt;br&gt;gw 10.10.10.1 | mgmt 172.20.20.4" style="rounded=1;html=1;whiteSpace=wrap;strokeWidth=2;fontSize=12;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="250" y="570" width="220" height="95" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;web&lt;/b&gt;&lt;br&gt;nginx (80/443) + SSH (22)&lt;br&gt;eth1 : 10.10.20.10&lt;br&gt;gw 10.10.20.1 | mgmt 172.20.20.3" style="rounded=1;html=1;whiteSpace=wrap;strokeWidth=2;fontSize=12;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="650" y="570" width="220" height="95" as="geometry"/></mxCell><mxCell id="c12" value="fw:eth2 ↔ attacker:eth1&lt;br&gt;lien WAN" style="html=1;endArrow=none;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="fw:eth1 ↔ sw:eth1&lt;br&gt;trunk 802.1Q (VLAN 10, 20)" style="html=1;endArrow=none;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="sw:eth2 ↔ client:eth1&lt;br&gt;accès VLAN 10" style="html=1;endArrow=none;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="sw:eth3 ↔ web:eth1&lt;br&gt;accès VLAN 20" style="html=1;endArrow=none;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="Réseau de gestion 172.20.20.0/24 (eth0 de chaque nœud) — supervision uniquement, contourne le pare-feu&lt;br&gt;Hôte Ubuntu 24.04 : Docker + Containerlab (Prometheus/Grafana en semaine 4)" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="880" height="50" as="geometry"/></mxCell><mxCell id="c17" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="c7" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="c8" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="c9" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="c10" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="c11" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Plan d'adressage&lt;/b&gt;&lt;table border='1' cellpadding='3' style='border-collapse:collapse;font-size:11px'&gt;&lt;tr&gt;&lt;th&gt;Zone&lt;/th&gt;&lt;th&gt;VLAN&lt;/th&gt;&lt;th&gt;Réseau&lt;/th&gt;&lt;th&gt;Passerelle&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LAN&lt;/td&gt;&lt;td&gt;10&lt;/td&gt;&lt;td&gt;10.10.10.0/24&lt;/td&gt;&lt;td&gt;10.10.10.1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;DMZ&lt;/td&gt;&lt;td&gt;20&lt;/td&gt;&lt;td&gt;10.10.20.0/24&lt;/td&gt;&lt;td&gt;10.10.20.1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ATK&lt;/td&gt;&lt;td&gt;— (WAN)&lt;/td&gt;&lt;td&gt;10.10.30.0/24&lt;/td&gt;&lt;td&gt;10.10.30.1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Gestion&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;172.20.20.0/24&lt;/td&gt;&lt;td&gt;172.20.20.1&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Routage&lt;/b&gt; : statique. Chaque hôte : 10.10.0.0/16 via sa passerelle fw.&lt;br&gt;fw : routes connectées, ip_forward=1." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="980" y="140" width="330" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>