# Copier en monitoring/.env puis remplir (ce fichier .env n'est JAMAIS commite)
# 1) Telegram : @BotFather -> /newbot -> copier le token
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 2) Envoyer un message au bot, puis ouvrir
#    https://api.telegram.org/bot<TOKEN>/getUpdates  ->  "chat":{"id": ...}
TELEGRAM_CHAT_ID=123456789
# 3) Mot de passe admin Grafana (utilisateur : admin)
GF_SECURITY_ADMIN_PASSWORD=twin-admin
