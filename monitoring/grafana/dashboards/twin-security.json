        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Scenario deploye",
      "description": "Valeur de la variable SCENARIO dans le conteneur fw.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "twin_scenario_info",
          "range": false,
          "instant": true,
          "legendFormat": "{{scenario}}"
