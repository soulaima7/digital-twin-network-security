          },
          "refId": "A",
          "expr": "twin_web_response_seconds",
          "range": true,
          "instant": false,
          "legendFormat": "temps de reponse"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
